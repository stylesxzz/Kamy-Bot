# Kamy Bot — single-user local desktop application
KAMY_PORT=8765
# Keep bound to localhost by default. Change only behind a trusted VPN/firewall/reverse proxy.
KAMY_BIND=127.0.0.1
# 1 enables Playwright browser automation in Docker; 0 is recommended for native/Termux mode.
KAMY_BROWSER_ENABLED=0
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Optional override for the local Fernet key. If blank, Kamy reuses .env when present or creates data/.master_key.
# Never delete or replace the key after credentials have been saved; keep a secure backup.
KAMY_MASTER_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep 1 behind HTTPS. Set 0 only for local HTTP development.

# Exact comma-separated HTTPS hostnames permitted for live MCP calls (empty = deny all).
KAMY_MCP_ALLOWED_HOSTS=

# Public HTTPS hostname used by Caddyfile.example (set DNS A/AAAA to your server).
KAMY_DOMAIN=kamy.example.com
