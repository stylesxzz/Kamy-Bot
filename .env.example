KAMY_PORT=8000
# Configure the NVIDIA API key per coworker in the app. Never commit API keys.
# Set to 0 for native Android/Termux mode without Playwright browser.
KAMY_BROWSER_ENABLED=1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep private and persistent. Never commit a real value.
KAMY_MASTER_KEY=
